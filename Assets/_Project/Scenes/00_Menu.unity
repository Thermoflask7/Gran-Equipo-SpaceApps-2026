  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>The game</b>\nSpace Mission Simulator Astra: a game to understand how a space mission is planned and carried out.\n\n<b>Our project</b>\nYou plan a crewed lunar orbit mission: you read the mission, choose and train the crew, buy parts and assemble the rocket, and pick the launch site and date. Then you fly the mission: departure, lunar orbit and return, solving minigames and events.\n\n<b>The team: Gran Equipo</b>\nMateo Zaragoza, Mar Fr\xEDas, Cristina Mendoza, Fer Gautr\xEDn and Elena Fierros"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
