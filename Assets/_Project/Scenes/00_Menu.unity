      m_Calls: []
  m_text: '<b>The challenge</b>

    Space Mission Design Game, proposed by the Canadian Space Agency: a game to understand how a space mission is planned and carried out.


    <b>Our project</b>

    You plan a crewed lunar orbit mission: you read the mission, choose and train the crew, buy parts and assemble the rocket, and pick the launch site and date. Then you fly the mission: departure, lunar orbit and return, solving minigames and events.


    <b>The team</b>

    [Team name and the 5 members]'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
