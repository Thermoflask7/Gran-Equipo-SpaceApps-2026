# Normalizar saltos de línea (Windows/Mac mezclados)
* text=auto

# Archivos de Unity en texto (YAML)
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.meta      text eol=lf
*.controller text eol=lf
*.anim      text eol=lf
*.cs        text diff=csharp

# Binarios: que Git no intente hacer merge ni diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.fbx  binary
*.obj  binary
*.glb  binary
*.gltf binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
